<?xml version="1.0"?>
<robot name="vertical_arm_4dof">
  <material name="dark_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.20 0.45 0.80 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.55 0.15 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.16 0.16 0.10"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.16 0.16 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.16 0 0"/>
      <geometry>
        <box size="0.32 0.05 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.16 0 0"/>
      <geometry>
        <box size="0.32 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.16 0 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.013" iyz="0" izz="0.013"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2.5"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.14 0 0"/>
      <geometry>
        <box size="0.28 0.045 0.045"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.14 0 0"/>
      <geometry>
        <box size="0.28 0.045 0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.14 0 0"/>
      <mass value="0.85"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.009"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="2.8"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.12 0 0"/>
      <geometry>
        <box size="0.24 0.04 0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0"/>
      <geometry>
        <box size="0.24 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.12 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="40" velocity="3.0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz="0.10 0 0"/>
      <geometry>
        <box size="0.20 0.035 0.035"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.10 0 0"/>
      <geometry>
        <box size="0.20 0.035 0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.10 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.24 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="30" velocity="3.2"/>
  </joint>

  <link name="ee_link">
    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="ee_fixed_joint" type="fixed">
    <parent link="link4"/>
    <child link="ee_link"/>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
  </joint>
</robot>
