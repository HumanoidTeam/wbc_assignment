<?xml version="1.0"?>
<robot name="vertical_arm_3dof">
  <material name="dark_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.20 0.45 0.80 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.55 0.15 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.16 0.16 0.10"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.16 0.16 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.05 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0"/>
      <geometry>
        <box size="0.35 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.015"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="2.5"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.045 0.045"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.045 0.045"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.010"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="50" velocity="2.5"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.04"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.30 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6" upper="2.6" effort="40" velocity="3.0"/>
  </joint>

  <link name="ee_link">
    <visual>
      <origin xyz="0.06 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.06 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.06 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="ee_fixed_joint" type="fixed">
    <parent link="link3"/>
    <child link="ee_link"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
  </joint>
</robot>
